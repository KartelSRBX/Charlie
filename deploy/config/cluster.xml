<clickhouse>
    <!-- Generated from topology.yaml by `charlie render`. Do not edit. -->
    <zookeeper>
        <node>
            <host>keeper-1</host>
            <port>9181</port>
        </node>
        <node>
            <host>keeper-2</host>
            <port>9181</port>
        </node>
        <node>
            <host>keeper-3</host>
            <port>9181</port>
        </node>
        <session_timeout_ms>10000</session_timeout_ms>
        <operation_timeout_ms>5000</operation_timeout_ms>
    </zookeeper>

    <!-- Credentials for the backup bucket live in the server config, matched by URL prefix, so a
         BACKUP statement carries no secret and none ends up in query_log. -->
    <s3>
        <backups>
            <endpoint>http://minio:9000/backups/</endpoint>
            <access_key_id from_env="S3_ACCESS_KEY"/>
            <secret_access_key from_env="S3_SECRET_KEY"/>
        </backups>
    </s3>

    <!-- Where users, roles and grants live. SQL-created access entities go to Keeper, so a role
         created on one node exists on all of them: no ON CLUSTER needed for RBAC. -->
    <user_directories replace="replace">
        <users_xml>
            <path>users.xml</path>
        </users_xml>
        <replicated>
            <zookeeper_path>/clickhouse/access</zookeeper_path>
        </replicated>
    </user_directories>

    <!-- People are SQL users that check their password against this server (IDENTIFIED WITH ldap),
         and `charlie access apply` keeps their roles in line with the directory groups. They are
         not an LDAP *user directory* on purpose: those users exist only on the node they logged
         in to, so a Distributed query, which re-runs as the same user on the other shards, fails. -->
    <ldap_servers>
        <directory>
            <host>ldap</host>
            <port>389</port>
            <bind_dn>cn={user_name},ou=people,dc=charlie,dc=local</bind_dn>
            <enable_tls>no</enable_tls>
            <verification_cooldown>5</verification_cooldown>
        </directory>
    </ldap_servers>

    <remote_servers>
        <charlie>
            <!-- Distributed queries run as the initiating user on every shard, authenticated
                 by this shared secret instead of a stored password. -->
            <secret from_env="CH_INTERSERVER_SECRET"/>
            <shard>
                <!-- The replicated tables copy the data between replicas, so a write goes to
                     one replica of the shard only. -->
                <internal_replication>true</internal_replication>
                <replica>
                    <host>ch-s1-r1</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>ch-s1-r2</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <!-- The replicated tables copy the data between replicas, so a write goes to
                     one replica of the shard only. -->
                <internal_replication>true</internal_replication>
                <replica>
                    <host>ch-s2-r1</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>ch-s2-r2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </charlie>
    </remote_servers>
</clickhouse>
